<?php

namespace {{ namespace }}\Application\QueryHandlers;

use {{ namespace }}\Application\Queries\{{ query }};
{{#repository}}
use {{ namespace }}\Domain\Repositories\{{ repository }};
{{/repository}}
use {{ namespace }}\Domain\Entities\{{ entity }};

final class {{ handler }}
{
    {{#repository}}
        public function __construct(
            private {{ repository }} $repository
        ) {}
    {{/repository}}

    public function __invoke({{ query }} $query): ?{{ entity }}
    {
        return $this->repository->getById($query->id);
    }
}
