<?php

namespace {{ namespace }}\Application\CommandHandlers;

use {{ namespace }}\Application\Commands\{{ command }};
{{#repository}}
use {{ namespace }}\Domain\Repositories\{{ repository }};
{{/repository}}
{{#entity}}
use {{ namespace }}\Domain\Entities\{{ entity }};
{{/entity}}

final class {{ handler }}
{
{{#repository}}
    public function __construct(
        private {{ repository }} $repository
    ) {}
{{/repository}}

    public function __invoke({{ command }} $command): {{ entity }}
    {
        $entity = new {{ entity }}(
            $command->payload
        );

        $this->repository->save($entity);

        return $entity;
    }
}
