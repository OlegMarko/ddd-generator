{
    "name": "fixik/ddd-generator",
    "description": "DDD generator for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Fixik\\DddGenerator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fixik\\DddGenerator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html=coverage --coverage-clover=coverage.xml"
    },
    "extra": {
        "laravel": {
            "providers": [
                "\\Fixik\\DddGenerator\\DddGeneratorServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "oleg.m"
        }
    ]
}
